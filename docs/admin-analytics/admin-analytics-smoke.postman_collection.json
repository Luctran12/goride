{
  "info": {
    "_postman_id": "c5cb6962-d1d0-4d50-9dc6-55c3cc0cb006",
    "name": "GoRide Admin Analytics API Smoke",
    "description": "Phase 6 consumer smoke collection. Set baseUrl and accessToken for an ADMIN account. All examples use [from, to) and Asia/Ho_Chi_Minh.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "from",
      "value": "2026-07-01T00:00:00+07:00"
    },
    {
      "key": "to",
      "value": "2026-07-02T00:00:00+07:00"
    },
    {
      "key": "timezone",
      "value": "Asia/Ho_Chi_Minh"
    }
  ],
  "item": [
    {
      "name": "Overview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/analytics/overview?from={{from}}&to={{to}}&timezone={{timezone}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "analytics",
            "overview"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            },
            {
              "key": "timezone",
              "value": "{{timezone}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test('Freshness metadata', () => pm.expect(pm.response.json().data.dataFreshnessAt).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Demand timeseries",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/analytics/demand/timeseries?from={{from}}&to={{to}}&timezone={{timezone}}&bucket=HOUR",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "analytics",
            "demand",
            "timeseries"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            },
            {
              "key": "timezone",
              "value": "{{timezone}}"
            },
            {
              "key": "bucket",
              "value": "HOUR"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Points array', () => pm.expect(pm.response.json().data.points).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Supply timeseries",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/analytics/supply/timeseries?from={{from}}&to={{to}}&timezone={{timezone}}&bucket=HOUR",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "analytics",
            "supply",
            "timeseries"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            },
            {
              "key": "timezone",
              "value": "{{timezone}}"
            },
            {
              "key": "bucket",
              "value": "HOUR"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Coverage is explicit', () => pm.expect(pm.response.json().data.points[0]).to.have.property('snapshotCoverage'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Demand heatmap",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/analytics/demand/heatmap?from={{from}}&to={{to}}&timezone={{timezone}}&cellSizeMeters=1000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "analytics",
            "demand",
            "heatmap"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            },
            {
              "key": "timezone",
              "value": "{{timezone}}"
            },
            {
              "key": "cellSizeMeters",
              "value": "1000"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('GeoJSON FeatureCollection', () => pm.expect(pm.response.json().data.type).to.eql('FeatureCollection'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Matching performance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/analytics/matching/performance?from={{from}}&to={{to}}&timezone={{timezone}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "analytics",
            "matching",
            "performance"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            },
            {
              "key": "timezone",
              "value": "{{timezone}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Backend percentile field', () => pm.expect(pm.response.json().data).to.have.property('p95MatchingDurationMs'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Matching funnel",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/analytics/matching/funnel?from={{from}}&to={{to}}&timezone={{timezone}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "analytics",
            "matching",
            "funnel"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            },
            {
              "key": "timezone",
              "value": "{{timezone}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Five stable steps', () => pm.expect(pm.response.json().data.steps).to.have.lengthOf(5));"
            ]
          }
        }
      ]
    }
  ]
}
